<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.xarch</groupId>
        <artifactId>xarch</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>xarch-bom</artifactId>
    <packaging>pom</packaging>
    <name>xarch-bom</name>
    <description>Bill of Materials for xarch framework</description>

    <properties>
        <xarch.version>1.0.0</xarch.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- xarch Starters -->
            <dependency>
                <groupId>com.xarch</groupId>
                <artifactId>xarch-common-core</artifactId>
                <version>${xarch.version}</version>
            </dependency>
            <dependency>
                <groupId>com.xarch</groupId>
                <artifactId>xarch-db-spring-boot-starter</artifactId>
                <version>${xarch.version}</version>
            </dependency>
            <dependency>
                <groupId>com.xarch</groupId>
                <artifactId>xarch-web-spring-boot-starter</artifactId>
                <version>${xarch.version}</version>
            </dependency>
            <dependency>
                <groupId>com.xarch</groupId>
                <artifactId>xarch-cache-spring-boot-starter</artifactId>
                <version>${xarch.version}</version>
            </dependency>

            <!-- MyBatis -->
            <dependency>
                <groupId>org.mybatis.spring.boot</groupId>
                <artifactId>mybatis-spring-boot-starter</artifactId>
                <version>3.0.4</version>
            </dependency>

            <!-- PageHelper -->
            <dependency>
                <groupId>com.github.pagehelper</groupId>
                <artifactId>pagehelper-spring-boot-starter</artifactId>
                <version>2.1.0</version>
            </dependency>

            <!-- Druid -->
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>druid-spring-boot-starter</artifactId>
                <version>1.2.23</version>
            </dependency>

            <!-- Redisson -->
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson-spring-boot-starter</artifactId>
                <version>3.38.1</version>
            </dependency>

            <!-- Knife4j -->
            <dependency>
                <groupId>com.github.xiaoymin</groupId>
                <artifactId>knife4j-openapi-starter</artifactId>
                <version>4.5.0</version>
            </dependency>

            <!-- Fastjson2 -->
            <dependency>
                <groupId>com.alibaba.fastjson2</groupId>
                <artifactId>fastjson2</artifactId>
                <version>2.0.52</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>