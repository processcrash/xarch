<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xarch.oa.mapper.LeaveRequestMapper">

    <resultMap id="LeaveResult" type="com.xarch.oa.entity.LeaveRequest">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="type" column="type"/>
        <result property="startDate" column="start_date"/>
        <result property="endDate" column="end_date"/>
        <result property="days" column="days"/>
        <result property="reason" column="reason"/>
        <result property="status" column="status"/>
        <result property="currentApproverId" column="current_approver_id"/>
        <result property="attachments" column="attachments"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <select id="selectPendingForApprover" resultMap="LeaveResult">
        SELECT * FROM oa_leave_request
        WHERE is_deleted = 0
          AND status = 'APPROVING'
          AND current_approver_id = #{approverId}
        ORDER BY create_time DESC
    </select>

    <select id="selectByUserId" resultMap="LeaveResult">
        SELECT * FROM oa_leave_request
        WHERE is_deleted = 0
          AND user_id = #{userId}
        ORDER BY create_time DESC
    </select>

</mapper>
