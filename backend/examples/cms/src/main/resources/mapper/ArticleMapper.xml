<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xarch.cms.mapper.ArticleMapper">

    <resultMap id="ArticleResult" type="com.xarch.cms.entity.Article">
        <id property="id" column="id"/>
        <result property="title" column="title"/>
        <result property="content" column="content"/>
        <result property="summary" column="summary"/>
        <result property="categoryId" column="category_id"/>
        <result property="authorId" column="author_id"/>
        <result property="status" column="status"/>
        <result property="viewCount" column="view_count"/>
        <result property="likeCount" column="like_count"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="publishedTime" column="published_time"/>
    </resultMap>

    <!-- Articles that have a particular tag. -->
    <select id="selectByTagId" resultMap="ArticleResult">
        SELECT a.*
        FROM cms_article a
        INNER JOIN cms_article_tag at ON at.article_id = a.id
        WHERE at.tag_id = #{tagId}
          AND a.is_deleted = 0
        ORDER BY a.create_time DESC
    </select>

    <!-- Articles in a particular category, newest first. -->
    <select id="selectByCategoryId" resultMap="ArticleResult">
        SELECT a.*
        FROM cms_article a
        WHERE a.category_id = #{categoryId}
          AND a.is_deleted = 0
        ORDER BY a.create_time DESC
    </select>

    <!-- Atomic counter increment. -->
    <update id="incrementViewCount">
        UPDATE cms_article
        SET view_count = view_count + 1
        WHERE id = #{id} AND is_deleted = 0
    </update>

    <update id="incrementLikeCount">
        UPDATE cms_article
        SET like_count = like_count + 1
        WHERE id = #{id} AND is_deleted = 0
    </update>

</mapper>
