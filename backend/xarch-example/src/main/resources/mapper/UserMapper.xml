<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xarch.example.mapper.UserMapper">

    <resultMap id="BaseResultMap" type="com.xarch.example.entity.User">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="username" property="username" jdbcType="VARCHAR"/>
        <result column="password" property="password" jdbcType="VARCHAR"/>
        <result column="email" property="email" jdbcType="VARCHAR"/>
        <result column="mobile" property="mobile" jdbcType="VARCHAR"/>
        <result column="status" property="status" jdbcType="INTEGER"/>
        <result column="create_time" property="createTime" jdbcType="BIGINT"/>
        <result column="update_time" property="updateTime" jdbcType="BIGINT"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, username, password, email, mobile, status, create_time, update_time
    </sql>

    <select id="findById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM sys_user
        WHERE id = #{id}
    </select>

    <select id="findByUsername" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM sys_user
        WHERE username = #{username}
    </select>

    <select id="findAll" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM sys_user
        ORDER BY id DESC
    </select>

    <insert id="insert" parameterType="com.xarch.example.entity.User" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sys_user (username, password, email, mobile, status, create_time, update_time)
        VALUES (#{username}, #{password}, #{email}, #{mobile}, #{status}, UNIX_TIMESTAMP() * 1000, UNIX_TIMESTAMP() * 1000)
    </insert>

    <update id="update" parameterType="com.xarch.example.entity.User">
        UPDATE sys_user
        SET username = #{username},
            password = #{password},
            email = #{email},
            mobile = #{mobile},
            status = #{status},
            update_time = UNIX_TIMESTAMP() * 1000
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM sys_user WHERE id = #{id}
    </delete>

</mapper>