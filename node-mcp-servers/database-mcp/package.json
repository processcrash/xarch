{
  "name": "@xarch/database-mcp",
  "version": "1.0.0",
  "description": "xarch Database MCP Server - Multi-database support (Node.js / Bun)",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "xarch-database-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:bun": "bun run dist/index.js",
    "dev": "tsx watch src/index.ts",
    "dev:bun": "bun --watch run src/index.ts",
    "dev:node": "node --watch --loader tsx src/index.ts"
  },
  "keywords": ["mcp", "database", "mysql", "postgresql", "mongodb", "bun"],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "mysql2": "^3.9.0",
    "pg": "^8.11.0",
    "mongodb": "^6.3.0",
    "mssql": "^10.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "tsx": "^4.7.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "bun": ">=1.0.0"
  }
}