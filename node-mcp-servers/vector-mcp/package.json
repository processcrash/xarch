{
  "name": "@xarch/vector-mcp",
  "version": "1.0.0",
  "description": "xarch Vector Database MCP Server - Support for Qdrant, Milvus, Chroma, Weaviate, Pinecone, PGvector (Node.js / Bun)",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "xarch-vector-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:bun": "bun run dist/index.js",
    "dev": "tsx watch src/index.ts",
    "dev:bun": "bun --watch run src/index.ts",
    "dev:node": "node --watch --loader tsx src/index.ts"
  },
  "keywords": ["mcp", "vector", "qdrant", "milvus", "chroma", "weaviate", "pinecone", "pgvector", "embedding", "bun"],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@qdrant/qdrant-js": "^2.0.0",
    "@grpc/grpc-js": "^1.9.0",
    "@grpc/proto-loader": "^0.7.0",
    "chroma-js": "^2.4.0",
    "weaviate-client": "^3.1.0",
    "pg": "^8.11.0",
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.10.0",
    "typescript": "^5.3.0",
    "tsx": "^4.7.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "bun": ">=1.0.0"
  }
}